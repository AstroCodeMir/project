// apps/api/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         Role      @default(VIEWER)
  permissions  String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Example relation (optional, for later content management)
  posts        Post[]
}

model Post {
  id          String    @id @default(cuid())
  title       String
  content     String?
  published   Boolean   @default(false)
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author      User      @relation(fields: [authorId], references: [id])
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  VIEWER
}
