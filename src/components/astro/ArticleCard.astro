---
const { title, image, summary, author, date, href } = Astro.props;
---

<article class="bg-white shadow-md rounded-2xl overflow-hidden hover:shadow-lg transition-shadow">
  <img src={image} alt={title} class="w-full h-48 object-cover" />

  <div class="p-4">
    <h3 class="text-xl font-semibold text-brown-700 mb-2">
      <a href={href} class="hover:text-orange-600 transition">{title}</a>
    </h3>
    <p class="text-gray-600 mb-3">{summary}</p>
    <div class="text-sm text-gray-500 flex justify-between items-center">
      <span>By {author}</span>
      <span>{date}</span>
    </div>
  </div>
</article>
