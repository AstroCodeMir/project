---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";

---

<Layout title="Media | Happy Tails">
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-orange-700 mb-6">Media Gallery</h1>
    <p class="text-brown-700 mb-10">
      A collection of adorable pet moments and videos shared by our Happy Tails community.
    </p>

    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
      <img src="/images/pet1.jpg" alt="Adopted Dog" class="rounded-xl shadow-md hover:scale-105 transition" />
      <img src="/images/pet2.jpg" alt="Playful Cat" class="rounded-xl shadow-md hover:scale-105 transition" />
      <img src="/images/pet3.jpg" alt="Pet Adoption Event" class="rounded-xl shadow-md hover:scale-105 transition" />
      <img src="/images/pet4.jpg" alt="Cute Puppy" class="rounded-xl shadow-md hover:scale-105 transition" />
      <img src="/images/pet5.jpg" alt="Rescue Success" class="rounded-xl shadow-md hover:scale-105 transition" />
      <img src="/images/pet6.jpg" alt="Adoption Fair" class="rounded-xl shadow-md hover:scale-105 transition" />
    </div>

    <div class="mt-10 text-center">
      <a href="#" class="bg-orange-500 text-white px-6 py-3 rounded-lg hover:bg-orange-600 transition">
        View More
      </a>
    </div>
  </section>
</Layout>
