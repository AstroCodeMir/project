---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/astro/ArticleCard.astro";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";

const articles = [
  {
    title: "Meet Bella — Our Star Adoption Story 🐶",
    image: "/images/adopt-bella.jpg",
    summary: "From shelter to forever home, Bella found her Happy Tail! Read how her journey began.",
    author: "Team Happy Tails",
    date: "Oct 21, 2025",
    href: "/blog/meet-bella"
  },
  {
    title: "Tips for First-Time Pet Owners",
    image: "/images/first-pet-tips.jpg",
    summary: "Bringing a new pet home soon? Here's what every first-time owner should know.",
    author: "Dr. Paw",
    date: "Oct 18, 2025",
    href: "/blog/first-time-pet-owner"
  },
  {
    title: "5 Signs Your Cat is Truly Happy 😺",
    image: "/images/happy-cat.jpg",
    summary: "Cats can be mysterious — here are simple ways to know when your kitty is content!",
    author: "Jane Pawson",
    date: "Oct 15, 2025",
    href: "/blog/happy-cat-signs"
  },
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="text-center py-16 bg-orange-100 rounded-3xl shadow-sm mb-10">
    <h1 class="text-4xl font-extrabold text-orange-700 mb-4">
      Every Paw Deserves a Happy Tail 🐾
    </h1>
    <p class="max-w-2xl mx-auto text-brown-700 mb-6">
      Adopt, love, and celebrate your furry friends.  
      Join our mission to give every pet a loving home.
    </p>
    <a href="/adopt"
      class="bg-orange-500 text-white px-6 py-3 rounded-full font-medium hover:bg-orange-600 transition">
      Adopt Now
    </a>
  </section>

  <!-- Articles Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-brown-700 mb-6 text-center">Latest Stories</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map(article => (
        <ArticleCard {...article} />
      ))}
    </div>
  </section>

  <!-- Community Section -->
  <section class="text-center bg-orange-50 py-12 rounded-3xl shadow-inner">
    <h3 class="text-2xl font-bold text-orange-700 mb-2">Join Our Pet Community</h3>
    <p class="text-brown-700 mb-5">
      Stay updated on adoption drives, rescue stories, and new pet care tips.
    </p>
    <form class="flex justify-center max-w-md mx-auto">
      <input
        type="email"
        placeholder="Your email address"
        class="w-full px-3 py-2 rounded-l-lg text-brown-800 focus:outline-none"
      />
      <button
        type="submit"
        class="bg-orange-500 px-4 py-2 rounded-r-lg hover:bg-orange-600 transition text-white">
        Subscribe
      </button>
    </form>
  </section>
</BaseLayout>
