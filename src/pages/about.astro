---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout title="About Us | Happy Tails">
  <section class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-orange-700 mb-6">About Happy Tails</h1>
    <p class="text-brown-700 mb-4 leading-relaxed">
      At <strong>Happy Tails</strong>, we believe every pet deserves a loving home.  
      Founded in 2020, we’ve helped connect over <strong>2,000 pets</strong> with their forever families.
    </p>

    <p class="text-brown-700 mb-4 leading-relaxed">
      Our mission is to make adoption accessible, transparent, and joyful —  
      empowering pet lovers to make a difference, one tail at a time.
    </p>

    <div class="bg-orange-50 border border-orange-200 rounded-xl p-6 mt-8">
      <h2 class="text-2xl font-semibold text-orange-700 mb-4">What We Do</h2>
      <ul class="list-disc list-inside text-brown-700 space-y-2">
        <li>Support animal shelters and rescue partners across the country</li>
        <li>Host adoption drives and fundraising events</li>
        <li>Share pet care resources and success stories</li>
        <li>Promote responsible pet ownership</li>
      </ul>
    </div>

    <div class="text-center mt-10">
      <a href="/contact" class="bg-orange-500 text-white px-6 py-3 rounded-lg hover:bg-orange-600 transition">
        Get In Touch
      </a>
    </div>
  </section>
</Layout>
