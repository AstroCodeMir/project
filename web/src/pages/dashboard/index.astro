---
import Dashboard from "../../components/react/Dashboard.tsx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/astro/Header.astro";
import Footer from "../../components/astro/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<BaseLayout title="Dashboard | Happy Tails">
  <section class="min-h-screen bg-orange-50 py-10">
    <div class="max-w-6xl mx-auto px-6">
      <h1 class="text-3xl font-bold text-orange-700 mb-6">
        🐾 Happy Tails Admin Dashboard
      </h1>
      <p class="text-gray-700 mb-10">
        Welcome back! Manage articles, media, users, and comments — all in one place.
      </p>

      <!-- React Dashboard Component -->
      <div class="bg-white p-6 rounded-2xl shadow-md border border-orange-100">
        <Dashboard client:load />
      </div>
    </div>
  </section>
</BaseLayout>
