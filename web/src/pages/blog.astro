---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";

---

<Layout title="Articles | Happy Tails">
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-orange-700 mb-6">Latest Articles</h1>
    <p class="text-brown-700 mb-10">
      Read helpful guides and stories about pet adoption, care, and inspiring rescue journeys. 🐶🐱
    </p>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Article 1 -->
      <article class="bg-white shadow-md rounded-xl overflow-hidden hover:shadow-lg transition">
        <img src="/images/article1.jpg" alt="Adoption Tips" class="h-48 w-full object-cover" />
        <div class="p-4">
          <h2 class="text-xl font-semibold text-orange-700">5 Tips for a Smooth Pet Adoption</h2>
          <p class="text-sm text-brown-700 mt-2">Learn what to prepare before bringing home your new furry friend.</p>
          <a href="#" class="text-orange-500 mt-3 inline-block hover:underline">Read more →</a>
        </div>
      </article>

      <!-- Article 2 -->
      <article class="bg-white shadow-md rounded-xl overflow-hidden hover:shadow-lg transition">
        <img src="/images/article2.jpg" alt="Pet Nutrition" class="h-48 w-full object-cover" />
        <div class="p-4">
          <h2 class="text-xl font-semibold text-orange-700">Healthy Meals for Happy Pets</h2>
          <p class="text-sm text-brown-700 mt-2">A guide to affordable, nutritious pet food options and recipes.</p>
          <a href="#" class="text-orange-500 mt-3 inline-block hover:underline">Read more →</a>
        </div>
      </article>

      <!-- Article 3 -->
      <article class="bg-white shadow-md rounded-xl overflow-hidden hover:shadow-lg transition">
        <img src="/images/article3.jpg" alt="Pet Safety" class="h-48 w-full object-cover" />
        <div class="p-4">
          <h2 class="text-xl font-semibold text-orange-700">Keeping Pets Safe During Travel</h2>
          <p class="text-sm text-brown-700 mt-2">Tips for ensuring comfort and safety when traveling with pets.</p>
          <a href="#" class="text-orange-500 mt-3 inline-block hover:underline">Read more →</a>
        </div>
      </article>
    </div>
  </section>
</Layout>
