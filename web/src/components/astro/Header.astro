---
import SearchBar from "../islands/SearchBar.tsx";
import UserMenu from "../islands/UserMenu.tsx";
---

<header class="bg-orange-100 border-b border-orange-200 shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2">
      <img
        src="/images/Paw.jpg"
        alt="Happy Tails Logo"
        class="w-10 h-10 rounded-full object-cover"
      />
      <span class="text-2xl font-extrabold text-orange-700 tracking-tight">
        Happy Tails
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/" class="text-brown-800 font-medium hover:text-orange-600 transition">
        Home
      </a>
      <a href="/blog" class="text-brown-800 font-medium hover:text-orange-600 transition">
        Articles
      </a>
      <a href="/media" class="text-brown-800 font-medium hover:text-orange-600 transition">
        Media
      </a>
      <a href="/about" class="text-brown-800 font-medium hover:text-orange-600 transition">
        Pages
      </a>
      <a href="/dashboard" class="text-brown-800 font-medium hover:text-orange-600 transition">
        Dashboard
      </a>
    </nav>

    <!-- Desktop Right Section -->
    <div class="hidden md:flex items-center gap-4">
      <SearchBar client:load />
      <UserMenu client:load />
    </div>

    <!-- Mobile Toggle Button -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 rounded-md bg-orange-200 hover:bg-orange-300 transition"
      aria-label="Toggle menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 text-orange-700"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Right Sidebar Drawer (Mobile Navigation) -->
  <aside
    id="mobile-sidebar"
    class="fixed top-0 right-0 h-full w-72 bg-orange-50 border-l border-orange-200 transform translate-x-full transition-transform duration-300 ease-in-out z-50 shadow-lg md:hidden flex flex-col"
  >
    <div class="flex justify-between items-center px-6 py-4 border-b border-orange-200">
      <h3 class="text-xl font-semibold text-orange-700">Menu</h3>
      <button id="close-sidebar" class="text-orange-600 text-2xl focus:outline-none">✖</button>
    </div>

    <nav class="flex flex-col gap-2 px-6 py-4">
      <a href="/" class="py-2 text-brown-800 font-medium hover:text-orange-600 transition">Home</a>
      <a href="/blog" class="py-2 text-brown-800 font-medium hover:text-orange-600 transition">Articles</a>
      <a href="/media" class="py-2 text-brown-800 font-medium hover:text-orange-600 transition">Media</a>
      <a href="/pages/about" class="py-2 text-brown-800 font-medium hover:text-orange-600 transition">Pages</a>
      <a href="/dashboard" class="py-2 text-brown-800 font-medium hover:text-orange-600 transition">Dashboard</a>
    </nav>

    <div class="mt-auto p-4 border-t border-orange-200 flex flex-col gap-4">
      <SearchBar client:load />
      <UserMenu client:load />
    </div>
  </aside>

  <!-- Background Overlay -->
  <div
    id="overlay"
    class="fixed inset-0 bg-black bg-opacity-40 hidden z-40 md:hidden"
  ></div>

  <!-- JS for Sidebar Toggle -->
  <script>
    const toggle = document.getElementById("menu-toggle");
    const sidebar = document.getElementById("mobile-sidebar");
    const closeBtn = document.getElementById("close-sidebar");
    const overlay = document.getElementById("overlay");

    toggle?.addEventListener("click", () => {
      sidebar.classList.remove("translate-x-full");
      overlay.classList.remove("hidden");
    });

    closeBtn?.addEventListener("click", () => {
      sidebar.classList.add("translate-x-full");
      overlay.classList.add("hidden");
    });

    overlay?.addEventListener("click", () => {
      sidebar.classList.add("translate-x-full");
      overlay.classList.add("hidden");
    });
  </script>
</header>
